GOOGLE_API_KEY=your-google-api-key-here
SESSION_BUDGET_USD=1.00

# LLM — local via SGLang (see backend/app/model_profiles.toml for supported models)
LLM_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
LOCAL_LLM_URL=http://127.0.0.1:5200/v1
# To use a hosted model instead, unset LOCAL_LLM_URL and set LLM_MODEL to e.g.
# google-gla:gemini-3.1-flash-lite-preview or anthropic:claude-haiku-4-5-20251001

# Image — local FLUX
LOCAL_IMAGE_URL=http://127.0.0.1:5100
LOCAL_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B

# Logging / observability (run `logfire auth` before enabling)
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOGFIRE_ENABLED=false

# Dev: wipe cache.db + sprite files on backend startup
CLEAR_CACHE_ON_STARTUP=false
