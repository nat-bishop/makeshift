GOOGLE_API_KEY=your-google-api-key-here
FAL_KEY=your-fal-api-key-here
SESSION_BUDGET_USD=1.00
LLM_TIMEOUT_SECONDS=30
IMAGE_TIMEOUT_SECONDS=30
MAX_CONCURRENT_IMAGE_REQUESTS=3
DATABASE_PATH=data/game.db
HOST=0.0.0.0
PORT=8000

# Model configuration
LLM_MODEL=google-gla:gemini-3.1-flash-lite-preview
# Other supported providers (change LLM_MODEL to swap):
# LLM_MODEL=anthropic:claude-haiku-4-5-20251001
# LLM_MODEL=openai:gpt-4o-mini
# Local LLM via SGLang (set LOCAL_LLM_URL to enable; LLM_MODEL becomes the model name)
# LLM_MODEL=Qwen/Qwen3.5-9B
# LLM_MODEL=Qwen/Qwen3.5-4B
# LLM_MODEL=lovedheart/Qwen3.5-4B-FP8
# LLM_MODEL=lovedheart/Qwen3.5-9B-FP8
# LLM_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
# LOCAL_LLM_URL=http://127.0.0.1:5200/v1
# Sampling + SGLang server config loaded from backend/app/model_profiles.toml based on LLM_MODEL.
# Change LLM_MODEL, run `make llm-restart` — everything else is in the profile.
IMAGE_MODEL=gemini-3.1-flash-image-preview
# Image generation backend: "gemini" (default), "local" (FLUX via SGLang), "fal" (fal.ai FLUX)
IMAGE_BACKEND=local
# URL of local FLUX server (only used when IMAGE_BACKEND=local)
LOCAL_IMAGE_URL=http://127.0.0.1:5100
LOCAL_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-9B
# HuggingFace token (required for gated models like FLUX.2-klein-9B)
# HF_TOKEN=hf_your-token-here
# fal.ai FLUX model (only used when IMAGE_BACKEND=fal)
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
# "local" (in-process BiRefNet-lite GPU) or "cloud" (fal.ai birefnet)
BG_REMOVAL_BACKEND=local
# Set to false to bypass sprite cache (forces regeneration every time)
SPRITE_CACHE_ENABLED=false
# Logging
LOG_LEVEL=DEBUG
# "console" (colored, human-readable) or "json" (structured)
LOG_FORMAT=console

# Observability (run `logfire auth` first, then set to true)
LOGFIRE_ENABLED=false
