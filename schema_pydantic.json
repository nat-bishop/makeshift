{
  "$defs": {
    "BehaviorAction": {
      "enum": [
        "MOVE_TOWARD",
        "MOVE_AWAY",
        "PATROL",
        "DEAL_DAMAGE",
        "APPLY_FORCE",
        "ATTRACT",
        "SPAWN_PROJECTILE",
        "EXPLODE",
        "HEAL",
        "ADD_TAGS",
        "REMOVE_TAGS",
        "SELF_DESTRUCT"
      ],
      "title": "BehaviorAction",
      "type": "string"
    },
    "BehaviorSpec": {
      "description": "Simplified behavior model for LLM output. Expanded to full Behavior after.",
      "properties": {
        "trigger": {
          "$ref": "#/$defs/BehaviorTrigger"
        },
        "action": {
          "$ref": "#/$defs/BehaviorAction"
        },
        "target": {
          "$ref": "#/$defs/BehaviorTarget",
          "default": "NEAREST_OBJECT"
        },
        "power": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Power",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "trigger_tag": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tag"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags_to_apply": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Tag"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags To Apply"
        }
      },
      "required": [
        "trigger",
        "action"
      ],
      "title": "BehaviorSpec",
      "type": "object"
    },
    "BehaviorTarget": {
      "enum": [
        "SELF",
        "NEAREST_OBJECT",
        "NEAREST_LIVING",
        "NEAREST_PLAYER",
        "CONTACT_BODY"
      ],
      "title": "BehaviorTarget",
      "type": "string"
    },
    "BehaviorTrigger": {
      "enum": [
        "ALWAYS",
        "ON_TIMER",
        "ON_PROXIMITY",
        "ON_CONTACT",
        "ON_DAMAGED",
        "ON_HEALTH_LOW",
        "ON_TAG_ADDED",
        "ON_CREATE",
        "ON_DESTROY"
      ],
      "title": "BehaviorTrigger",
      "type": "string"
    },
    "Tag": {
      "enum": [
        "SOLID",
        "LIQUID",
        "GAS",
        "RIGID",
        "FLEXIBLE",
        "HEAVY",
        "LIGHT",
        "FROZEN",
        "COLD",
        "HOT",
        "MOLTEN",
        "FLAMMABLE",
        "HEAT_SOURCE",
        "ELECTRIC",
        "MAGNETIC",
        "EXPLOSIVE",
        "SHARP",
        "STICKY",
        "SLIPPERY",
        "REFLECTIVE",
        "BOUNCY",
        "BREAKABLE",
        "FLOATING",
        "WIND_SOURCE",
        "CORROSIVE",
        "TOXIC",
        "LIVING",
        "GLOWING",
        "CONDUCTING",
        "INSULATING"
      ],
      "title": "Tag",
      "type": "string"
    },
    "VisualDescriptor": {
      "properties": {
        "visual_description": {
          "title": "Visual Description",
          "type": "string"
        },
        "size_category": {
          "enum": [
            "tiny",
            "small",
            "medium",
            "large",
            "huge"
          ],
          "title": "Size Category",
          "type": "string"
        }
      },
      "required": [
        "visual_description",
        "size_category"
      ],
      "title": "VisualDescriptor",
      "type": "object"
    }
  },
  "description": "Simplified LLM output model using BehaviorSpec instead of Behavior.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "tags": {
      "items": {
        "$ref": "#/$defs/Tag"
      },
      "maxItems": 6,
      "minItems": 2,
      "title": "Tags",
      "type": "array"
    },
    "behaviors": {
      "items": {
        "$ref": "#/$defs/BehaviorSpec"
      },
      "maxItems": 3,
      "title": "Behaviors",
      "type": "array"
    },
    "visual_descriptor": {
      "$ref": "#/$defs/VisualDescriptor"
    }
  },
  "required": [
    "name",
    "tags",
    "visual_descriptor"
  ],
  "title": "CreatorOutputSpec",
  "type": "object"
}