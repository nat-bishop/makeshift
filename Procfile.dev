gpu: docker compose -f services/sglang/docker-compose.yml up --build sglang; docker compose -f services/sglang/docker-compose.yml stop sglang
llm: docker compose -f services/sglang/docker-compose.yml up llm; docker compose -f services/sglang/docker-compose.yml stop llm
api: uv run uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir backend
